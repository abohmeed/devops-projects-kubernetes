# Copy to .env and replace every value. Never commit .env.
# MySQL root password (used only by MySQL itself and by an admin; the app never logs in as root)
DB_ROOT_PASSWORD=change-me-root
# The application's own MySQL user and its password
DB_USER=weatherapp
DB_PASSWORD=change-me-app
# Secret that signs and verifies login tokens; auth and ui must share it
JWT_SECRET=change-me-to-a-long-random-string
# Your WeatherAPI.com key (https://www.weatherapi.com/). Leave empty to run without live weather.
WEATHER_API_KEY=
