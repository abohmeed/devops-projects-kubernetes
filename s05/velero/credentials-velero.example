# ONLY for clusters that cannot use EKS Pod Identity (for example the kOps or
# kubeadm clusters from Section 1). On EKS, use Pod Identity instead and do
# not create this file.
#
# Copy to credentials-velero (never commit it), fill in the keys of an IAM
# user that has ONLY velero-policy.json attached, then install with:
#   helm upgrade --install velero vmware-tanzu/velero --version 12.2.0 \
#     -n velero --create-namespace -f values.yaml \
#     --set credentials.useSecret=true \
#     --set-file credentials.secretContents.cloud=./credentials-velero
[default]
aws_access_key_id=<AWS_ACCESS_KEY_ID>
aws_secret_access_key=<AWS_SECRET_ACCESS_KEY>
